{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["examples/ts/**/*.ts", "exercises/**/ts/**/*.ts", "projects/*/{starter,solution}/ts/**/*.ts", "projects/*/evals/**/*.ts"]
}
