---
// "Hidden" = collapsed. On a public site the solution is still in the page source and repo.
import { Code } from "@astrojs/starlight/components";
import { readRepoFile } from "./repo";

interface Props { path: string; lang?: string; label?: string }
const { path, lang, label = "Show solution" } = Astro.props;
const code = readRepoFile(path).trimEnd();
const ext = path.split(".").pop() ?? "";
const language = lang ?? (({ py: "python", md: "md", yaml: "yaml", yml: "yaml" } as Record<string, string>)[ext] ?? "ts");
---
<details class="solution">
  <summary>{label}</summary>
  <slot />
  <Code code={code} lang={language} title={path} />
</details>
